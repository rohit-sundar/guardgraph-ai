NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Local LLM via Ollama — make sure `ollama serve` is running
# and the model is pulled: ollama pull qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

MODEL_PATH=data/models/guardgraph_xgb_v1.json
SAMPLES_DIR=data/samples

# obfuscation / scoring thresholds — tune against your demo set
ENTROPY_HIGH_THRESHOLD=7.2
FLATTENING_DEGREE_OUTLIER_ZSCORE=3.0

# Third-party intelligence API keys for initial triage
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=


# Third-party reputation lookups for (app/analysis/signatures.py)
ONLINE_LOOKUPS_ENABLED=true

# Scoped dynamic verification (Phase 8, opt-in — see app/analysis/dynamic_verification.py
# and app/analysis/frida_scripts/README.md for the one-time AVD+Frida setup this needs).
# Off by default; even with this on, dynamic analysis only runs when a request explicitly
# passes /analyze?enable_dynamic=true — an unattended AVD is not something to assume.
DYNAMIC_ANALYSIS_ENABLED=false
DYNAMIC_ANALYSIS_TIMEOUT_SECONDS=30
# Safety gate, not a convenience switch — refuses to install an APK unless a live
# probe measures the AVD's egress as blocked. Only set false if you've verified
# isolation some other way (see the firewall rule in frida_scripts/README.md).
DYNAMIC_ANALYSIS_REQUIRE_NETWORK_ISOLATION=true
# adb's default port 5037 can collide with a Hyper-V dynamic port-exclusion range on
# Windows (confirmed on the dev machine — check with
# `netsh int ipv4 show excludedportrange protocol=tcp` if adb refuses to start).
ADB_SERVER_PORT=5039
# Full path to adb.exe / adb — auto-detected from ANDROID_HOME/ANDROID_SDK_ROOT if unset,
# but set explicitly if adb isn't reliably resolvable in the server process's environment.
ADB_PATH=
# Which attached device to target. Empty = whichever single device is attached.
# Set explicitly (e.g. emulator-5554) once a second AVD or a physical phone could
# also be plugged in, so a stray device can't silently become the target.
ADB_DEVICE_SERIAL=
FRIDA_DEVICE_ID=

# ── AVD auto-boot (per-machine — this is the block to edit on a new machine) ──
# With this on, Phase 8 boots the AVD itself when no device is attached, so a
# request only has to pass enable_dynamic=true. Set false to fail fast instead
# (e.g. CI, or where something else owns the emulator's lifecycle).
DYNAMIC_ANALYSIS_AUTO_BOOT=true
# ***The one value most likely to differ between machines.*** The name of YOUR AVD,
# exactly as `emulator -list-avds` prints it (e.g. Pixel_5, guardgraph_test).
# Leave empty ONLY if you have exactly one AVD installed — with several, Phase 8
# refuses to guess and names them, rather than picking the wrong one.
# Pick a 'google_apis' image, NOT 'google_apis_playstore': the Play-signed image
# looks identical in -list-avds but is locked down and blocks Frida from injecting,
# which shows up much later as a confusing "could not attach to pid N".
AVD_NAME=
# Full path to the SDK's emulator binary — auto-detected from ANDROID_HOME/
# ANDROID_SDK_ROOT (<sdk>/emulator/emulator.exe) if unset. It is NOT in
# platform-tools/ alongside adb, and must be run from its own directory.
EMULATOR_PATH=
# Software rendering by default — hardware GPU passthrough is the usual cause of an
# emulator that hangs or dies on boot, and nothing here needs GPU speed. Set to
# "host" for a faster boot if this machine's GPU is known good.
EMULATOR_GPU_MODE=swiftshader_indirect
# How long to wait for a cold boot to reach sys.boot_completed. Varies hugely by
# machine — ~20s on an accelerated x86_64 image, minutes on an unaccelerated one.
AVD_BOOT_TIMEOUT_SECONDS=300
