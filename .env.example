NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Local LLM via Ollama — make sure `ollama serve` is running
# and the model is pulled: ollama pull qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

MODEL_PATH=data/models/guardgraph_xgb_v1.json
SAMPLES_DIR=data/samples

# obfuscation / scoring thresholds — tune against your demo set
ENTROPY_HIGH_THRESHOLD=7.2
FLATTENING_DEGREE_OUTLIER_ZSCORE=3.0
