NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Local LLM via Ollama — make sure `ollama serve` is running
# and the model is pulled: ollama pull qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

MODEL_PATH=data/models/guardgraph_xgb_v1.json
SAMPLES_DIR=data/samples

# obfuscation / scoring thresholds — tune against your demo set
ENTROPY_HIGH_THRESHOLD=7.2
FLATTENING_DEGREE_OUTLIER_ZSCORE=3.0

# Third-party intelligence API keys for initial triage
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=


# Third-party reputation lookups for (app/analysis/signatures.py)
ONLINE_LOOKUPS_ENABLED=true

# Scoped dynamic verification (Phase 8, opt-in — see app/analysis/dynamic_verification.py
# and app/analysis/frida_scripts/README.md for the one-time AVD+Frida setup this needs).
# Off by default; even with this on, dynamic analysis only runs when a request explicitly
# passes /analyze?enable_dynamic=true — an unattended AVD is not something to assume.
DYNAMIC_ANALYSIS_ENABLED=false
DYNAMIC_ANALYSIS_TIMEOUT_SECONDS=30
# Safety gate, not a convenience switch — refuses to install an APK unless a live
# probe measures the AVD's egress as blocked. Only set false if you've verified
# isolation some other way (see the firewall rule in frida_scripts/README.md).
DYNAMIC_ANALYSIS_REQUIRE_NETWORK_ISOLATION=true
# adb's default port 5037 can collide with a Hyper-V dynamic port-exclusion range on
# Windows (confirmed on the dev machine — check with
# `netsh int ipv4 show excludedportrange protocol=tcp` if adb refuses to start).
ADB_SERVER_PORT=5039
# Full path to adb.exe / adb — auto-detected from ANDROID_HOME/ANDROID_SDK_ROOT if unset,
# but set explicitly if adb isn't reliably resolvable in the server process's environment.
ADB_PATH=
ADB_DEVICE_SERIAL=
FRIDA_DEVICE_ID=
