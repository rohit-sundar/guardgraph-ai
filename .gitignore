venv/
.venv/
__pycache__/
*.pyc
.env
data/samples/*
!data/samples/.gitkeep

# Generated by app/analysis/brand_lookup.py — a local cache of live Google
# Play Store lookups, not source data. Safe to delete; it just refills.
data/cache/*
!data/cache/.gitkeep
*.egg-info/
.DS_Store

# Everything under bin/ is a local binary download (Ollama builds, frida-server
# — see scripts/setup_dynamic_analysis.py), never source. Ignore the whole
# directory rather than naming each binary: a narrower `bin/ollama/` rule
# already let a 3.2 GB `bin/ollama_old_v0.32.5/` directory sit completely
# untracked-but-not-ignored on this machine (found live, right before a
# push — a broad `git add` would have committed 3.2 GB of binaries into
# history). This project's own change log already records committing an
# Ollama build to git by accident once before (TEAM_CONTEXT.md, "Web UI"
# session entry) — a wildcard here is deliberately blunt so a differently-
# named future download can't repeat either incident.
bin/

# Throwaway keystore used only to re-sign malware samples missing a valid
# signature before dynamic-verification install (app/analysis/dynamic_verification.py)
data/dynamic/

# Build-time-only Frida agent bundling deps — see app/analysis/frida_scripts/README.md
app/analysis/frida_scripts/node_modules/

# Live screenshots captured during dynamic verification (app/analysis/dynamic_verification.py)
app/static/screenshots/

# Obsidian & Local Task Tracking
.obsidian/
AI_ENGINEER_TASKS.md
*.tasks.md

# Virtual Environments
.venv/


# Real malware samples — must never be committed to a public repo
test_malware_samples/
# Downloaded APKs from MalwareBazaar (scripts/build_ttp_dataset.py) — real malware
data/ttp_apks/

# Benign APK corpus (scripts/build_ttp_dataset.py --stage c) — ~1GB, regeneratable
data/benign_apks/*
!data/benign_apks/.gitkeep
data/benign_holdout/*
!data/benign_holdout/.gitkeep

# Genuine brand APKs for scripts/build_brand_reference.py. Proprietary third-party
# binaries pulled from official store listings — the derived icon_phash/cert_sha256 in
# data/reference/protected_brands.json are what belong in git, not the APKs themselves.
data/reference/apks/*
!data/reference/apks/.gitkeep

# Run logs (scripts/build_ttp_dataset.py writes a per-run file sink here) —
# keep the directory in the repo, ignore everything written into it
logs/*
!logs/.gitkeep

# Corpus score dumps (scripts/score_corpus.py) — measurement output, regeneratable
data/corpus_scores*.json

# Per-family download caps (scripts/family_targets.py) — derived from the current
# manifest state each run, regeneratable
data/family_caps.json

# ─────────────────────────────────────────────────────────────────────────────
# HACKATHON ARRANGEMENT — revert after the event.
#
# The following are normally gitignored and are deliberately TRACKED right now, so
# that a `git pull` gives a teammate a checkout that actually runs rather than one
# that silently degrades. Each fails QUIETLY when absent, which is why shipping them
# beats documenting them:
#
#   data/models/*.joblib, *.json   the trained TTP + family models. Without the
#                                  joblib the MITRE tab is empty and two score
#                                  components sit at 0 with no error. (5.5 MB)
#   data/*.csv                     ttp_dataset.csv, needed by train_model.py and
#                                  scripts/measure_saturation.py. (0.6 MB)
#   data/yara_rules/               ~500 community rules. The download script works,
#                                  but it is a network step that can fail on the day;
#                                  the engine silently falls back to 8 built-in rules
#                                  and only says so in the startup log. (6.9 MB)
#   guardgraph_test/*.apk          the demo sample that /analyze_sample depends on.
#                                  This is REAL MALWARE. It is acceptable here only
#                                  because this repository is private — it MUST be
#                                  removed, and this block reverted, before the repo
#                                  is ever made public. (7.2 MB)
#
# Total added to the repository: ~20 MB. Still excluded below: the multi-GB APK
# corpora, the virtualenv, the Ollama build, and .env (live API keys — those belong
# in a private message, never in git history, because history outlives the decision
# to make a repo public).
# ─────────────────────────────────────────────────────────────────────────────
